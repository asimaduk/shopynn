APP_PORT=4000
NODE_ENV=production

PGHOST=localhost
PGPORT=5432
PGUSER=shopynn
PGPASSWORD=changeme
PGDATABASE=shopynn

JWT_SECRET=replace-me
OTP_SECRET=replace-me

PAYSTACK_SECRET_KEY=
PAYSTACK_MIN_WITHDRAWAL_GHS=1
PAYSTACK_AUTO_WITHDRAWAL=true
# Agent commission payouts: real Paystack transfers only when this is true (stubbed without a Paystack key).
AGENT_PAYOUTS_ENABLED=false
AGENT_PAYOUT_MIN_GHS=50
AGENT_MANAGER_OVERRIDE_RATE=0.2
PAYSTACK_MOMO_FEE_PERCENT=2
PAYMENT_CALLBACK_URL=https://app.example.com/payment/callback
FRONTEND_URL=https://app.example.com
# Browser origins allowed to call the API (comma-separated). Defaults to the Shopynn web and site domains.
# CORS_ORIGINS=https://dashboard.shopynn.app,https://shopynn.app,https://www.shopynn.app

# SMS (Hubtel Programmable SMS) — leave blank until ready
SMS_PROVIDER=hubtel
SMS_CLIENT_ID=
SMS_CLIENT_SECRET=
SMS_SENDER_ID=
# SMS_HUBTEL_URL=https://smsc.hubtel.com/v1/messages/send
# Return verification codes in API responses when SMS fails. Testing only — never leave on once SMS works.
STOREFRONT_OTP_DEV=false

AWS_ACCESSKEYID=
AWS_SECRETACCESSKEY=
S3_BUCKET_NAME=
S3_BUCKET_REGION=
S3_REGION=

MERCHANT_DEFAULT_COMMISSION_PERCENT=0
# Email (Resend). Senders are <mailbox>@MAIL_DOMAIN: no-reply, support, billing, hello.
RESEND_API_KEY=
MAIL_DOMAIN=shopynn.app
# Optional per-sender overrides, e.g. MAIL_FROM_SUPPORT=help@shopynn.app
# MAIL_FROM_NOREPLY=
# MAIL_FROM_SUPPORT=
# MAIL_FROM_BILLING=
# MAIL_FROM_HELLO=
DAILY_SALES_SUMMARY_JOB_ENABLED=false
DAILY_SALES_SUMMARY_CRON=
SUBSCRIPTION_EXPIRY_CRON=

<?xml version="1.0" encoding="utf-8"?>
<!-- Restrict network to HTTPS only; no cleartext (prevents accidental API downgrade).
     Exception: allow cleartext for localhost/emulator (Metro bundler on 10.0.2.2). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- Allow cleartext for Metro bundler on emulator/physical device localhost -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.10.109</domain>
        <domain includeSubdomains="true">172.20.10.3</domain>
        <domain includeSubdomains="true">o47fh1tg20.execute-api.af-south-1.amazonaws.com</domain>
    </domain-config>
</network-security-config>

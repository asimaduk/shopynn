<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system CAs only. User-installed CAs are not trusted, so a proxy
     certificate on the device can't decrypt API traffic. Debug overrides live in src/debug. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (overrides main/res/xml). Allows Metro and the print agent over LAN HTTP and
     user-installed CAs for proxy debugging. Release builds use the strict main config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

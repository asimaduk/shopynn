<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (overrides main/res/xml). Allows Metro on localhost/LAN and user-installed
     CAs for proxy debugging. Release builds use the strict main config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.10.109</domain>
        <domain includeSubdomains="true">172.20.10.3</domain>
    </domain-config>
</network-security-config>

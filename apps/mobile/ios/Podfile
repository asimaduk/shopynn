# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'CheqStock' do
  config = use_native_modules!
  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # whisper-rn: CocoaPods may register the same xcframework header per slice (arm64, simulator, tvos…),
    # causing "Multiple commands produce …/whisper_rn.framework/Headers/whisper.h".
    pods_to_fix = ['whisper-rn']
    installer.pods_project.targets.each do |t|
      next unless pods_to_fix.include?(t.name) || t.name =~ /whisper/i

      t.build_phases.select do |p|
        p.isa == 'PBXCopyFilesBuildPhase' &&
          p.respond_to?(:dstSubfolderSpec) &&
          p.dstSubfolderSpec.to_s == '16'
      end.each do |phase|
        Pod::UI.puts "[#{t.name}] Removing Copy Files → Headers phase"
        t.build_phases.delete(phase)
      end

      headers_phases = t.build_phases.select { |p| p.isa == 'PBXHeadersBuildPhase' }
      headers_phases[1..]&.each do |phase|
        Pod::UI.puts "[#{t.name}] Removing extra Headers phase"
        t.build_phases.delete(phase)
      end

      headers_phase = t.build_phases.find { |p| p.isa == 'PBXHeadersBuildPhase' }
      next unless headers_phase&.files

      seen = {}
      headers_phase.files.dup.each do |file_ref|
        key = file_ref.display_name || file_ref.file_ref&.display_name || file_ref.uuid
        if seen[key]
          Pod::UI.puts "[#{t.name}] Removing duplicate header: #{key}"
          headers_phase.files.delete(file_ref)
        else
          seen[key] = true
        end
      end
    rescue StandardError => e
      Pod::UI.warn "[#{t.name}] Header cleanup skipped: #{e}"
    end
  end
end

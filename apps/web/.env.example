# Auth.js / NextAuth — required for session signing
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Canonical app origin (Auth.js redirect base). On Vercel set this to the live hostname,
# e.g. https://admin-shopynn.vercel.app — stale AUTH_URL sends logout to the old domain.
# AUTH_URL=http://127.0.0.1:3000
# NEXTAUTH_URL=http://127.0.0.1:3000
# NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Backend API (Railway). Used for API calls and product image URLs (`/api/images?id=…`).
# Production example: https://shopynn-production.up.railway.app
# NEXT_PUBLIC_API_BASE_URL=https://shopynn-production.up.railway.app

# Local API port fallback when NEXT_PUBLIC_API_BASE_URL is unset (dev only)
NEXT_PUBLIC_PORT=4000

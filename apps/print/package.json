{
  "name": "@shopynn/print",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "cors": "^2.8.5",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4",
    "express": "^5.1.0",
    "node-windows": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node -e \"console.log('@shopynn/print: use npm run package:mac|package:win')\"",
    "lint": "node -e \"console.log('@shopynn/print: no lint step')\"",
    "package:bundle:mac": "bash packaging/bundle/prepare-bundle.sh mac",
    "package:bundle:win": "bash packaging/bundle/prepare-bundle.sh win",
    "package:mac": "bash packaging/mac/build-pkg.sh",
    "package:win": "bash packaging/bundle/prepare-bundle.sh win && echo Open packaging/windows/shopynn-print.iss in Inno Setup on Windows to compile the installer."
  }
}
